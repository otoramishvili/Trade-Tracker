rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) { return request.auth != null && request.auth.uid == userId; }
    match /users/{userId} {
      allow read, create, update, delete: if owns(userId);
      match /trades/{tradeId} { allow read, create, update, delete: if owns(userId); }
    }
  }
}
